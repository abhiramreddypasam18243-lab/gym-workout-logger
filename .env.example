# === Database ===
DATABASE_URL=postgresql+asyncpg://gymlogger:CHANGE_ME_DB_PASSWORD@db:5432/gymlogger
POSTGRES_USER=gymlogger
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=gymlogger

# === Backend ===
SECRET_KEY=CHANGE_ME_SECRET_KEY_AT_LEAST_32_CHARS
ALLOWED_ORIGIN=http://localhost:8080
ENVIRONMENT=development
# Set to "false" to disable registration
REGISTRATION_ENABLED=true
# Set to "true" for demo mode (synthetic data only)
DEMO_MODE=false

# === TLS ===
# Trusted reverse proxy IP (for forwarded-protocol headers)
TRUSTED_PROXY_IP=127.0.0.1
